{
  "producer": {
    "name": "librdkafka",
    "version": "2.8.0",
    "configuration": {
      "driver": "kcat 1.7.1",
      "compression.codec": "snappy",
      "linger.ms": "500",
      "batch.num.messages": "100",
      "topic.metadata.refresh.interval.ms": "500",
      "enable.idempotence": "false (librdkafka default)",
      "acks": "all (librdkafka default)",
      "partition": 0,
      "keyDelimiter": ":",
      "headers": [
        "dup=first",
        "dup=second",
        "solo=one"
      ]
    }
  },
  "provenance": {
    "source": "Written by a real librdkafka producer (kcat) to a throwaway single-node Apache Kafka 4.3.1 broker whose topic keeps compression.type=producer. The batch is that broker's stored log segment (exactly one batch), copied unmodified.",
    "acquiredAt": "2026-10-26T12:30:56Z",
    "releaseOrEnvironment": "Debian trixie: kcat 1.7.1-3, librdkafka1 2.8.0-1 (apt); broker apache/kafka:4.3.1 (sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837, Kafka commit 26b251a451ce941d), topic librdkafka-snappy-capture: auto-created, 1 partition, broker defaults (compression.type=producer)",
    "commands": [
      "kcat -P -b localhost:39092 -t librdkafka-snappy-capture -p 0 -z snappy -K: -H dup=first -H dup=second -H solo=one -X linger.ms=500 -X batch.num.messages=100 -X topic.metadata.refresh.interval.ms=500 -l corpus.txt",
      "docker cp kafkajs-capture:/tmp/kafka-logs/librdkafka-snappy-capture-0/00000000000000000000.log segment.log",
      "kafka-dump-log.sh --files .../00000000000000000000.log --deep-iteration --print-data-log (Kafka 4.3.1, in the broker container)",
      "kcat -C -b localhost:39092 -X broker.address.family=v4 -t librdkafka-snappy-capture -p 0 -o beginning -e -J",
      "java -cp snappy-java-1.1.10.7.jar:. Unsnappy compressed-body.bin snappy-record-data.bin (org.xerial.snappy.Snappy.uncompress; framing detected from the bytes: raw, no xerial header)"
    ],
    "referenceDecoder": {
