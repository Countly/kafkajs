{
  "name": "@countly/kafkajs",
  "version": "3.0.0-alpha.4",
  "description": "KafkaJS-compatible, pure-JS Apache Kafka client for Kafka 4.0+ and Node.js 22+ (Countly-maintained fork of kafkajs)",
  "author": "Tulio Ornelas <ornelas.tulio@gmail.com>",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "kafka",
    "sasl",
    "scram"
  ],
  "contributors": [
    "Countly"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Countly/kafkajs.git"
  },
  "bugs": {
    "url": "https://github.com/Countly/kafkajs/issues"
  },
  "homepage": "https://github.com/Countly/kafkajs#readme",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run lint && npm run compat:check && npm run protocol:check && npm run test:kafka -- \"jest --ci --maxWorkers=4 --forceExit\"",
    "test:unit": "jest --testPathPatterns 'src/protocol/.*' 'src/protocol/compactPrimitives\\.spec\\.js' 'src/protocol/taggedFields\\.spec\\.js' 'src/protocol/uuid\\.spec\\.js' 'src/protocol/headers\\.spec\\.js' 'src/protocol/clientSoftware\\.spec\\.js' 'src/utils/.*' 'src/network/requestQueue/.*' 'src/network/__tests__/flexibleFraming\\.spec\\.js' 'src/network/__tests__/connectionReconnect\\.spec\\.js' 'src/retry/.*' 'src/producer/partitioners/.*' 'src/consumer/assigners/.*' 'src/loggers/.*' 'src/instrumentation/.*' 'src/errors\\.spec\\.js' 'src/network/maxInFlightRequests\\.spec\\.js' 'src/broker/saslAuthenticator/protocolAuthentication\\.spec\\.js' 'src/broker/saslAuthenticator/failureDiagnostics\\.spec\\.js' 'src/broker/__tests__/apiVersionsFallback\\.spec\\.js' 'src/broker/__tests__/apiVersionsRenegotiation\\.spec\\.js' 'src/broker/__tests__/apiVersionsPoolGeneration\\.spec\\.js' 'src/consumer/__tests__/crash\\.spec\\.js' 'src/consumer/__tests__/staleGeneration\\.spec\\.js' 'src/consumer/__tests__/recoverFromOffsetOutOfRange\\.spec\\.js' 'src/consumer/__tests__/errorPropagation\\.spec\\.js' 'src/consumer/__tests__/staticMembership\\.spec\\.js' 'src/consumer/__tests__/checkCrcs\\.spec\\.js' 'src/consumer/__tests__/checkCrcsCrash\\.spec\\.js' 'src/cluster/__tests__/metadataCache\\.spec\\.js' 'src/cluster/__tests__/metadataCacheWiring\\.spec\\.js' 'src/cluster/__tests__/rebootstrap\\.spec\\.js' 'src/consumer/offsetManager/__tests__/getCoordinator\\.spec\\.js' 'src/producer/initResilience\\.spec\\.js' 'src/consumer/offsetManager/__tests__/commitOffsets\\.spec\\.js' 'src/producer/eosManager/index\\.spec\\.js' 'src/producer/groupMessagesPerPartition\\.spec\\.js' 'src/producer/eosWarning\\.spec\\.js' 'src/producer/sendMessages\\.spec\\.js' 'src/consumer/__tests__/topicRecreated\\.spec\\.js' 'scripts/compat/.*' 'scripts/protocol/.*'",
    "test:coverage:unit": "jest --coverage --coverageThreshold '{}' --testPathPatterns 'src/protocol/.*' 'src/protocol/compactPrimitives\\.spec\\.js' 'src/protocol/taggedFields\\.spec\\.js' 'src/protocol/uuid\\.spec\\.js' 'src/protocol/headers\\.spec\\.js' 'src/protocol/clientSoftware\\.spec\\.js' 'src/utils/.*' 'src/network/requestQueue/.*' 'src/network/__tests__/flexibleFraming\\.spec\\.js' 'src/network/__tests__/connectionReconnect\\.spec\\.js' 'src/retry/.*' 'src/producer/partitioners/.*' 'src/consumer/assigners/.*' 'src/loggers/.*' 'src/instrumentation/.*' 'src/broker/saslAuthenticator/failureDiagnostics\\.spec\\.js' 'src/broker/__tests__/apiVersionsFallback\\.spec\\.js' 'src/broker/__tests__/apiVersionsRenegotiation\\.spec\\.js' 'src/broker/__tests__/apiVersionsPoolGeneration\\.spec\\.js' 'src/consumer/__tests__/checkCrcs\\.spec\\.js' 'src/consumer/__tests__/checkCrcsCrash\\.spec\\.js' 'src/cluster/__tests__/metadataCache\\.spec\\.js' 'src/cluster/__tests__/metadataCacheWiring\\.spec\\.js' 'src/cluster/__tests__/rebootstrap\\.spec\\.js' 'src/producer/groupMessagesPerPartition\\.spec\\.js' 'src/producer/eosWarning\\.spec\\.js' 'src/producer/sendMessages\\.spec\\.js' 'src/consumer/__tests__/topicRecreated\\.spec\\.js' 'scripts/compat/.*' 'scripts/protocol/.*'",
    "test:coverage": "npm run test:kafka -- \"jest --ci --coverage --maxWorkers=4 --forceExit\"",
    "test:kafka": "./scripts/testWithKafka.sh",
    "test:group:broker": "jest --forceExit --testPathPatterns 'src/broker/.*'",
    "test:group:admin": "jest --forceExit --testPathPatterns 'src/admin/.*'",
    "test:group:producer": "jest --forceExit --testPathPatterns 'src/producer/.*'",
    "test:group:consumer": "jest --forceExit --testPathPatterns 'src/consumer/.*.spec.js'",
    "test:group:others": "jest --forceExit --testPathPatterns 'src/(?!(broker|admin|producer|consumer)/).*'",
    "test:group:oauthbearer": "OAUTHBEARER_ENABLED=1 jest --forceExit src/producer/index.spec.js src/broker/__tests__/connect.spec.js src/consumer/__tests__/connection.spec.js src/broker/__tests__/disconnect.spec.js src/admin/__tests__/connection.spec.js src/broker/__tests__/reauthenticate.spec.js",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand --watch",
    "test:types": "tsc -p types/",
    "test:pack": "./scripts/packSmoke.sh",
    "compat:generate": "node scripts/compat/index.js generate",
    "compat:check": "node scripts/compat/index.js check",
    "compat:fetch": "node scripts/compat/index.js fetch",
    "protocol:generate": "node scripts/protocol/index.js generate",
    "protocol:check": "node scripts/protocol/index.js check"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30",
    "@types/node": "^24",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-extended": "^7.0.0",
    "mockdate": "^2.0.5",
    "prettier": "^3.9.6",
    "semver": "^6.3.1",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "lz4-napi": "^2.10.0"
  }
}
