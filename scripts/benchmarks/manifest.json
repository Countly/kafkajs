    },
    {
      "file": "compareDecoderBounds.js",
      "reason": "An exit-gate decoder performance tool that compares frozen trees and exits 1 on missing evidence or an excessive slowdown, not a report entry."
    },
    {
      "file": "consumeCoverage.js",
      "reason": "The untimed coverage control of the consumer-partitions-1000 row, run on each tree through adapters/consumerSession.js; not a measurement."
    },
    {
      "file": "fetchSessions.js",
      "reason": "Run by the consumer-sessions-* rows through adapters/consumerSession.js, which supplies BENCH_NODES, the evidence directory, the topics and the L2 producer; never a plain entry."
    },
    {
      "file": "produceFrameSize.js",
      "reason": "A frame-size check against maxRequestSize that reports exact counts, not timings, and re-spawns itself with NODE_PATH set."
    },
    {
      "file": "rebalanceStorm.js",
      "reason": "Run once by the consumer-rebalanceStorm-200 row through adapters/consumerSession.js, its exit shown as information; never a plain entry."
    },
    {
      "file": "stickyAssign.js",
      "reason": "Its timing worker is run by the consumer-stickyAssign-g6 row through adapters/consumerSession.js; the differential --check is not a report entry."
    },
    {
      "file": "telemetry.js",
      "reason": "Run by the telemetrySession-* rows through adapters/telemetrySession.js (one row per telemetry-rows job), which checks the fixture, freezes and verifies the source snapshots, writes the session manifest and runs this controller and its --verify-session; not run directly."
